{
	"name": "theremid",
	"version": "2.0.0",
	"description": "A hands-in-the-air instrument controller for the web: Leap Motion, camera and touch theremin with many play modes and visual surfaces. Packaged as a HarmonEasy input.",
	"type": "module",
	"license": "GPL-2.0",
	"author": "designerzen",
	"repository": {
		"type": "git",
		"url": "https://github.com/designerzen/Leap-Motion-Theremin"
	},
	"keywords": [
		"theremin",
		"leap motion",
		"ultraleap",
		"hand tracking",
		"mediapipe",
		"web components",
		"midi 2.0",
		"harmoneasy"
	],
	"files": [
		"dist",
		"src"
	],
	"main": "./dist/theremid.js",
	"module": "./dist/theremid.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/theremid.js"
		},
		"./source": "./src/index.ts",
		"./harmoneasy": "./src/harmoneasy.ts"
	},
	"sideEffects": [
		"./src/index.ts",
		"./dist/theremid.js"
	],
	"scripts": {
		"dev": "vite",
		"build": "tsc -p tsconfig.build.json && node scripts/fix-declarations.mjs && vite build && vite build --mode demo",
		"preview": "vite preview --outDir dist-demo",
		"test": "vitest",
		"type-check": "tsc --noEmit"
	},
	"devDependencies": {
		"happy-dom": "^21.0.4",
		"typescript": "^7.0.2",
		"vite": "^8.3.7",
		"vitest": "^5.1.0"
	}
}
